# ==============================================================================
# Healthcare HR - Root Monorepo Environment Variables Template
# Copy this file to .env.local for local fullstack development
# ==============================================================================

# --- Fullstack Environment Mode ---
NODE_ENV=development

# --- Backend Service (server/) ---
PORT=3000
HOST=0.0.0.0
API_PREFIX=/api/v1
CORS_ORIGIN="*"
LOG_LEVEL=debug

# --- Database Service (PostgreSQL) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=healthcare_hr
POSTGRES_PORT=5432
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/healthcare_hr?schema=public"

# --- Authentication & Security ---
JWT_SECRET="replace_with_a_secure_random_secret_at_least_32_characters"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="replace_with_a_secure_refresh_secret_at_least_32_characters"
JWT_REFRESH_EXPIRES_IN="7d"

# --- Mobile Application (Mobile/) ---
EXPO_PUBLIC_APP_NAME="Healthcare HR (Local)"
EXPO_PUBLIC_APP_VARIANT="development"
EXPO_PUBLIC_ENV="local"
EXPO_PUBLIC_API_URL="http://localhost:3000/api/v1"
EXPO_PUBLIC_API_TIMEOUT_MS=15000
EXPO_PUBLIC_ENABLE_DEBUG_LOGS=true
EXPO_PUBLIC_ENABLE_MOCK_API=false
