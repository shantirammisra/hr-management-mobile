# ==============================================================================
# Healthcare HR - Root Monorepo Production Environment Template
# Copy this file to .env.production or inject secrets into CI/CD deployment pipelines
# ==============================================================================

# --- Fullstack Environment Mode ---
NODE_ENV=production

# --- Backend Service (server/) ---
PORT=3000
HOST=0.0.0.0
API_PREFIX=/api/v1
CORS_ORIGIN="https://hr.yourhospital.org"
LOG_LEVEL=info

# --- Database Service (PostgreSQL with SSL) ---
DATABASE_URL="postgresql://<PROD_DB_USER>:<PROD_DB_PASSWORD>@<PROD_DB_HOST>:5432/<PROD_DB_NAME>?schema=public&sslmode=require"

# --- Authentication & Security ---
JWT_SECRET="<GENERATE_SECURE_RANDOM_ACCESS_SECRET_AT_LEAST_64_CHARS>"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="<GENERATE_SECURE_RANDOM_REFRESH_SECRET_AT_LEAST_64_CHARS>"
JWT_REFRESH_EXPIRES_IN="7d"
THROTTLE_TTL=60
THROTTLE_LIMIT=60
OTP_EXPIRATION_SECONDS=300

# --- Mobile Application (Mobile/) ---
EXPO_PUBLIC_APP_NAME="Healthcare HR"
EXPO_PUBLIC_APP_VARIANT="production"
EXPO_PUBLIC_ENV="production"
EXPO_PUBLIC_API_URL="https://api.yourhospital.org/api/v1"
EXPO_PUBLIC_API_TIMEOUT_MS=10000
EXPO_PUBLIC_ENABLE_DEBUG_LOGS=false
EXPO_PUBLIC_ENABLE_MOCK_API=false
