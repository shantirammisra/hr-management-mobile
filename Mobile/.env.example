# ==============================================================================
# Mobile App Production Environment Variables Template (.env.example)
# Use this to configure your production release (.env.production / EAS Build)
# ==============================================================================

EXPO_PUBLIC_APP_NAME="Healthcare HR"
EXPO_PUBLIC_APP_VARIANT="production"
EXPO_PUBLIC_ENV="production"

# --- Backend API Endpoint (Your Production Server API) ---
EXPO_PUBLIC_API_URL="https://your-api-domain.com/api/v1"

# --- Supabase Public Integration (Storage & Realtime) ---
EXPO_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
EXPO_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_public_key"

# --- App Behavior ---
EXPO_PUBLIC_API_TIMEOUT_MS=10000
EXPO_PUBLIC_ENABLE_DEBUG_LOGS=false
EXPO_PUBLIC_ENABLE_MOCK_API=false
