# ==============================================================================
# Healthcare HR - Mobile App Environment Variables Template
# Copy this file to .env.local for local development
# ==============================================================================

EXPO_PUBLIC_APP_NAME="Healthcare HR (Local)"
EXPO_PUBLIC_APP_VARIANT="development"
EXPO_PUBLIC_ENV="local"

# Backend API Base URL
# - Web browser / iOS Simulator: http://localhost:3000/api/v1
# - Android Emulator (Loopback alias): http://10.0.2.2:3000/api/v1
# - Physical Mobile Device (Expo Go / Dev Client): http://<YOUR_COMPUTER_LAN_IP>:3000/api/v1
EXPO_PUBLIC_API_URL="http://localhost:3000/api/v1"

# Network & App Behavior
EXPO_PUBLIC_API_TIMEOUT_MS=15000
EXPO_PUBLIC_ENABLE_DEBUG_LOGS=true
EXPO_PUBLIC_ENABLE_MOCK_API=false
