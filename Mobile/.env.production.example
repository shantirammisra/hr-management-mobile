# ==============================================================================
# Healthcare HR - Mobile App Production Environment Template
# Copy this file to .env.production or configure in EAS Build Environment Variables
# ==============================================================================

EXPO_PUBLIC_APP_NAME="Healthcare HR"
EXPO_PUBLIC_APP_VARIANT="production"
EXPO_PUBLIC_ENV="production"

# Production Backend API URL (Must use HTTPS / TLS 1.3)
EXPO_PUBLIC_API_URL="https://api.yourhospital.org/api/v1"

# Network & App Behavior
EXPO_PUBLIC_API_TIMEOUT_MS=10000
EXPO_PUBLIC_ENABLE_DEBUG_LOGS=false
EXPO_PUBLIC_ENABLE_MOCK_API=false
