# ==============================================================================
# Server Production Environment Variables Template (.env.example)
# Use this to configure your production deployment (.env.production / Vercel)
# ==============================================================================

NODE_ENV=production
PORT=3000
HOST=0.0.0.0
API_PREFIX=/api/v1

# --- Supabase Database (PostgreSQL with SSL) ---
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[DB_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"
DIRECT_URL="postgresql://postgres:[DB_PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require"

# --- Supabase Platform & Storage ---
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_ANON_KEY="your_supabase_anon_public_key"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_secret_key"

# --- Authentication (JWT) ---
JWT_SECRET="replace_with_production_cryptographic_secret_min_32_characters_here"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="replace_with_production_refresh_secret_min_32_characters_here"
JWT_REFRESH_EXPIRES_IN="7d"

# --- CORS & Security ---
CORS_ORIGIN="https://your-app-domain.com,*"
LOG_LEVEL=info
THROTTLE_TTL=60
THROTTLE_LIMIT=60
OTP_EXPIRATION_SECONDS=300
