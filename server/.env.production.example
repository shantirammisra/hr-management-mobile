# ==============================================================================
# Healthcare HR - Server Production Environment Template
# Copy this file to .env.production on production servers or configure in CI/CD secrets
# ==============================================================================

NODE_ENV=production
PORT=3000
HOST=0.0.0.0
API_PREFIX=/api/v1

# Database Configuration (PostgreSQL with SSL enabled)
DATABASE_URL="postgresql://<PROD_DB_USER>:<PROD_DB_PASSWORD>@<PROD_DB_HOST>:5432/<PROD_DB_NAME>?schema=public&sslmode=require"

# JWT Authentication (Use 64-character random cryptographically secure strings)
JWT_SECRET="<GENERATE_SECURE_RANDOM_ACCESS_SECRET_AT_LEAST_64_CHARS>"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="<GENERATE_SECURE_RANDOM_REFRESH_SECRET_AT_LEAST_64_CHARS>"
JWT_REFRESH_EXPIRES_IN="7d"

# CORS Configuration (Comma-separated allowed domains, e.g. https://hr.yourhospital.org)
CORS_ORIGIN="https://hr.yourhospital.org"

# Application Logging
LOG_LEVEL=info

# Rate Limiting & Throttling
THROTTLE_TTL=60
THROTTLE_LIMIT=60

# Security & OTP
OTP_EXPIRATION_SECONDS=300
